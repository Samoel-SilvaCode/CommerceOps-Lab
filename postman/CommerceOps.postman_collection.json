{
  "info": {
    "name": "CommerceOps Lab | API PHP",
    "description": "Execute na ordem com Collection Runner. Altere baseUrl para o domínio publicado (sem barra final). Sessão independente do navegador. Pagamentos, fretes e marketplace simulados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://commerceops-lab.vercel.app"
    },
    {
      "key": "demoToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "initialStock",
      "value": ""
    },
    {
      "key": "paymentEvent",
      "value": ""
    },
    {
      "key": "cancelOrder",
      "value": ""
    },
    {
      "key": "beforeCancel",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/index.php?action=health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Envelope correto\", () => pm.expect(r.ok).to.eql(true));",
              "if (r.token) pm.collectionVariables.set(\"demoToken\", r.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Inicializar sessão",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
