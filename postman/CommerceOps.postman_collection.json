        "url": "{{baseUrl}}/api/index.php?action=bootstrap"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Envelope correto\", () => pm.expect(r.ok).to.eql(true));",
              "if (r.token) pm.collectionVariables.set(\"demoToken\", r.token);",
              "pm.collectionVariables.set(\"initialStock\", r.state.products[0].stock);",
              "pm.collectionVariables.set(\"paymentEvent\", \"postman-\" + Date.now());"
            ]
          }
        }
      ]
    },
